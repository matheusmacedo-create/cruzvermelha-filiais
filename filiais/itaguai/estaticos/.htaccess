# Site da Cruz Vermelha Brasileira – Filial de Itaguaí (gerado por cruzvermelha-filiais/scripts/gerar.py).
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Um endereço só, sem www (o http → https a Hostinger já faz; testar HTTPS aqui pode dar laço atrás do CDN).
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://cruzvermelhaitaguai.org/$1 [R=301,L]

  # /index.html → / (e o mesmo nas pastas).
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
</IfModule>
ErrorDocument 404 /404.html
