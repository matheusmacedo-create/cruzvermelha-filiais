# Site da Cruz Vermelha Brasileira – Filial de Petrópolis (pagina/scripts/gerar_site_petropolis.py).
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Um endereço só, sem www (o http → https a Hostinger já faz; testar HTTPS aqui pode dar laço atrás do CDN).
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://cruzvermelhapetropolis.org/$1 [R=301,L]

  # /index.html → / (e o mesmo nas pastas).
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  # Endereços da primeira versão do site (27/10/2026: páginas herdadas do RJ saíram).
  RewriteRule ^(doacao\.html|doar/?|doacao-indisponivel\.html)$ /doe/ [R=301,L]
  RewriteRule ^(cursos-gratuitos|voluntariado/cadastro)/?$ /voluntariado/ [R=301,L]
  RewriteRule ^(movimento-internacional|emblema|direito-internacional-humanitario|historia|equipe\.html|equipe|gestao|base-legal)/?$ /quem-somos/ [R=301,L]
  RewriteRule ^(termos|cookies|reembolso)/?$ /privacidade/ [R=301,L]
  RewriteRule ^(bio|links?|campanha-agasalho\.html|dia-das-criancas|projetocores|pedido-de-documentos|verificar|en|es)(/.*)?$ / [R=301,L]
</IfModule>
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
</IfModule>
ErrorDocument 404 /404.html
